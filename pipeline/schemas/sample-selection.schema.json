{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flameinfreefall.local/schemas/sample-selection.schema.json",
  "title": "Curated list of remote files to download",
  "type": "object",
  "required": ["budget_bytes", "files"],
  "additionalProperties": false,
  "properties": {
    "budget_bytes": {"type": "integer", "minimum": 1, "maximum": 250000000},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{"$ref": "common.schema.json#/$defs/remoteFile"}],
        "type": "object",
        "required": ["purpose", "reason"],
        "unevaluatedProperties": false,
        "properties": {
          "purpose": {"enum": ["evidence", "run-normalization"]},
          "reason": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
