{
  "accession": "PSI-101",
  "source_version": 4,
  "title": "Smoke Aerosol Measurement Experiment-Reflight",
  "acronym": "SAME-R",
  "coverage": "metadata_and_documents",
  "summary": {
    "text": "SAME-R, flown on the SAME hardware already on orbit, aims to quantify the sizes that liquid smoke particulate achieves in low gravity and to relate the droplet size distribution to smoke generation and transport conditions. The final report gives smoke particle diameters for Kapton, lamp wick, silicone, Teflon and Pyrell samples, including effects of aging and of zero air flow.",
    "evidence_ids": [
      "PSI-101:meta:objective#53315b73942a",
      "PSI-101:meta:approach#3c4c60a83b17",
      "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#92769f0ecada"
    ]
  },
  "safety_categories": [
    {
      "category": "detection",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#a12500d0d3e7",
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p9#9dcaef1e9da0"
      ]
    }
  ],
  "comparison": {
    "fuels": {
      "text": "Samples of 6 materials: Teflon, Kapton, Pyrell, silicone rubber, cellulose (lamp wick), and dibutyl-phthalate deposited on a porous wick.",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#92769f0ecada"
      ]
    },
    "geometry": null,
    "oxygen": null,
    "pressure": null,
    "flow": {
      "text": "Baseline air flow rate was 8 cm/s, with runs down to 2 cm/s and a limited set with no airflow while the sample was heated.",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#eef9ec5159fd"
      ]
    },
    "gravity": {
      "text": "The investigation aims to quantify smoke particle sizes in low gravity.",
      "evidence_ids": [
        "PSI-101:meta:objective#53315b73942a"
      ]
    },
    "measurements": {
      "text": "Diameter measurements from moment instruments (geometric mean, count mean and diameter of average mass); the approach also introduced the M-pass instrument alongside a DustTrak and an ionization detector.",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#7127c3989556",
        "PSI-101:meta:approach#af4cff67790a"
      ]
    },
    "hardware": {
      "text": "SAME hardware used on-orbit; experiment hardware listed as Comparitive Soot Diagnostic Hardware.",
      "evidence_ids": [
        "PSI-101:meta:approach#3c4c60a83b17",
        "PSI-101:meta:experimentHardware#03d7614a5c6f"
      ]
    }
  },
  "claims": [
    {
      "id": "C1",
      "type": "objective",
      "text": "The primary objective of SAME-R was to quantify the sizes that liquid smoke particulate achieves in low gravity and to relate the droplet size distribution to the smoke generation and smoke transport conditions.",
      "evidence_ids": [
        "PSI-101:meta:objective#53315b73942a"
      ]
    },
    {
      "id": "C2",
      "type": "hypothesis",
      "text": "SAME-R hypothesizes that liquid aerosol smokes produced in microgravity will exhibit substantially larger droplet sizes than under the same conditions in normal gravity.",
      "evidence_ids": [
        "PSI-101:meta:hypothesis#33db3878f29e"
      ]
    },
    {
      "id": "C3",
      "type": "reported_observation",
      "text": "In baseline runs, Table 1 reports the diameter of average mass increasing with 720 s aging: Kapton from 0.106 to 0.169 micrometers and Pyrell from 0.377 to 0.529 micrometers.",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#5ac9a253037d",
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#f1752d14ed65",
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#960ec7619876"
      ]
    },
    {
      "id": "C4",
      "type": "reported_observation",
      "text": "In baseline runs, Table 1 reports unaged diameters of average mass of 0.106 micrometers for Kapton and 0.173 micrometers for Teflon, compared with 0.271 micrometers for lampwick and 0.468 micrometers for silicone; the report states the Teflon and Kapton particles were very small.",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#5ac9a253037d",
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#960ec7619876",
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#f1ea32513a50",
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#a12500d0d3e7",
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#d6253dcd8a21"
      ]
    },
    {
      "id": "C5",
      "type": "potential_application",
      "text": "The report states that the much smaller Kapton and Teflon diameters will make detection of this smoke challenging for light scattering devices, and that detection will require a system capable of measuring more than one moment of the particle size distribution.",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#e94d329e85f0",
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#db08a8135cea"
      ]
    },
    {
      "id": "C6",
      "type": "reported_observation",
      "text": "The report states that for all of the materials the diameter of average mass was 30 % to 40 % larger in the zero-flow tests than in the flow tests.",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p9#e57e2b3fa51c"
      ]
    },
    {
      "id": "C7",
      "type": "potential_application",
      "text": "The report states that the larger particle diameters observed in zero-flow conditions are important to consider in the development of improved fire detection equipment for space vehicles.",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p9#9dcaef1e9da0"
      ]
    }
  ],
  "findings": [
    {
      "observation": "C4",
      "conditions": {
        "text": "Baseline runs at 8 cm/s air flow, with sample temperature selected to produce 1 to 2 mg of weight loss in 60 seconds; unaged diameters in micrometers.",
        "evidence_ids": [
          "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#eef9ec5159fd",
          "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#b272075d4659",
          "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#960ec7619876"
        ]
      },
      "implication": "C5",
      "category": "detection"
    },
    {
      "observation": "C6",
      "conditions": {
        "text": "Zero-flow tests (no airflow while the sample was heated) were examined for 11 tests and compared with flow tests; the report states this condition is unique to low-gravity scenarios.",
        "evidence_ids": [
          "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p4#eef9ec5159fd",
          "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p9#08e50384435c",
          "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p9#78d4d4be980a"
        ]
      },
      "implication": "C7",
      "category": "detection"
    }
  ],
  "limitations": [
    {
      "text": "In the zero-flow tests, approximately half the smoke was lost from the system, so total particle counts were lower than normal.",
      "basis": "source",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p9#7974c0983ce4"
      ]
    },
    {
      "text": "The repeatability of the diameter measurements is estimated to be +/- 15%.",
      "basis": "source",
      "evidence_ids": [
        "PSI-101:pdf:683dc530b8656d2315bf508c:v1:p5#1a923d369cd8"
      ]
    }
  ],
  "modeling_resources": [
    {
      "description": "Analyzed data for Kapton Run 62 and Pyrell Run 63, the runs shown in the report's TEM images of aging effects.",
