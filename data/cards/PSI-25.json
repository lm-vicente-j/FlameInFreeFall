        "PSI-25:meta:experimentHardware#4129335e38aa"
      ]
    }
  },
  "claims": [
    {
      "id": "C1",
      "type": "objective",
      "text": "The investigation aims to study the ignition, flame growth, flame spread, and extinction limits for solid fuels burning in low-velocity forced flows in microgravity.",
      "evidence_ids": [
        "PSI-25:meta:objective#72a40e33f18b"
      ]
    },
    {
      "id": "C2",
      "type": "hypothesis",
      "text": "The investigation hypothesizes that materials in microgravity, with adequate ventilation, burn as well if not better than the same material in normal gravity.",
      "evidence_ids": [
        "PSI-25:meta:hypothesis#14efa82d3fba"
      ]
    },
    {
      "id": "C3",
      "type": "reported_observation",
      "text": "In opposed-flow tests of PMMA samples, extinction velocities were found to be about 1 cm/s for thicknesses of 100, 200, and 300 µm and about 1.5 cm/s for 400 µm. In a test on a 100-µm sample with gradually reduced flow, the flame extinguished at an indicated flow velocity of about 1.1 cm/s.",
      "evidence_ids": [
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p31#2ced9760e29f",
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p31#ed87668dda80",
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p29#99a7179d5ac0"
      ]
    },
    {
      "id": "C4",
      "type": "reported_observation",
      "text": "At a lower O2 level of about 16 percent, extinction velocities were found to be about 2.6 cm/s for 100 µm and about 4 cm/s for 200 µm samples. The source states that the extinction velocity significantly increases as the O2 level is reduced.",
      "evidence_ids": [
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p31#a9562d348641",
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p33#c905951d93f1",
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p33#c5f99d1506bf"
      ]
    },
    {
      "id": "C5",
      "type": "potential_application",
      "text": "Measured extinction flow velocities and their dependence on O2 level are candidate inputs to the combustion computational models that the source says are used in designing fire detection and suppression systems in microgravity and on Earth.",
      "evidence_ids": [
        "PSI-25:meta:objective#018f6e59b025",
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p33#c5f99d1506bf"
      ]
    }
  ],
  "findings": [
    {
      "observation": "C3",
      "conditions": {
        "text": "PMMA samples 100 to 400 µm thick, 20 mm wide and about 95 mm long, burned in opposed flow in a 76-mm square duct aboard the ISS; flow was gradually reduced until the flame extinguished.",
        "evidence_ids": [
          "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p29#99a7179d5ac0",
          "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p31#ed87668dda80"
        ]
      },
      "implication": "C5",
      "category": "suppression"
    },
    {
      "observation": "C4",
      "conditions": {
        "text": "Opposed-flow tests on PMMA samples at a lower O2 level of about 16 percent, with 100-µm and 200-µm samples, aboard the ISS; sample widths differed between the two thicknesses.",
        "evidence_ids": [
          "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p31#a9562d348641",
          "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p33#c905951d93f1",
          "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p33#f4853d10ba42"
        ]
      },
      "implication": "C5",
      "category": "suppression"
    }
  ],
  "limitations": [
    {
      "text": "The source states there are significant uncertainties in the low extinction velocity values because calibration at such low velocity has high error bars.",
      "basis": "source",
      "evidence_ids": [
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p31#1a0770b08d8f"
      ]
    },
    {
      "text": "The lower-O2 data are limited: the source notes insufficient data at the lower O2 level, and sample width differed between the two thicknesses tested (20 mm for 100 µm, 10 mm for 200 µm).",
      "basis": "source",
      "evidence_ids": [
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p33#f4853d10ba42",
        "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p33#5e13fea375e9"
      ]
    },
    {
      "text": "The space-based extinction results come from a limited number of tests.",
