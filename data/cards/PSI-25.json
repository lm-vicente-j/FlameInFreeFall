  "title": "Burning and Suppression of Solids - II",
  "acronym": "BASS-II",
  "coverage": "metadata_and_documents",
  "summary": {
    "text": "BASS-II (Burning and Suppression of Solids - II) burned solid fuel samples in a small flow duct aboard the International Space Station, in the Microgravity Science Glovebox. The cited result is the opposed-flow velocity at which flames over thin PMMA sheets extinguished, and how that velocity changed with reduced O2.",
    "evidence_ids": [
      "PSI-25:meta:objective#72a40e33f18b",
      "PSI-25:meta:hypothesis#14efa82d3fba",
      "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p31#2ced9760e29f",
      "PSI-25:pdf:6924805f7f6aa6a83021067c:v2:p33#c5f99d1506bf"
    ]
  },
